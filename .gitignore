# ---------------------------------------------------------------------------
# Local machine state — never commit
# ---------------------------------------------------------------------------

# The live config: holds server addresses, and points at credential files.
gateway.toml

# Outbound definitions hold server credentials. Only the templates are tracked.
outbounds/*.json
!outbounds/*.example.json

# Rendered output. Regenerated by `gw render` on every apply.
build/

# Anything else local: keys, notes, scratch configs.
secrets/
*.key
*.crt
*.pem

# ---------------------------------------------------------------------------
# Editor / OS / language noise
# ---------------------------------------------------------------------------
*.bak
*.orig
*.rej
*~
.DS_Store
.idea/
.vscode/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Dashboard build inputs. dist/ is committed on purpose: the box builds the Go
# binary without Node, and the assets are embedded at compile time.
dashboard/node_modules/
bin/gw-bin
