# Generated by `gw apply` — DO NOT EDIT ON THE BOX
#
# The LAN side of a two-armed gateway. No Gateway= here, deliberately: the
# default route belongs to {{WAN_IF}}, and a second one pointing back at the
# network this box serves would send its own traffic in a circle.
#
# Nothing here hands out addresses. DHCP stays wherever it already is on this
# segment — it just has to advertise {{BOX_IP}} as both the gateway and the DNS
# server, which is what puts every device behind the tunnel with no per-device
# step.
[Match]
Name={{LAN_IF}}

[Network]
Address={{BOX_IP}}/{{PREFIX_LEN}}
# The box resolves through its own AdGuard instance, so its lookups are
# filtered and split exactly like the LAN's.
DNS=127.0.0.1
{{IPV6_NETWORK}}
[Link]
# Not required for boot. A dark office switch must not hold the box offline —
# it can still reach the tunnel, and networkd configures this link the moment
# it comes back.
RequiredForOnline=no
