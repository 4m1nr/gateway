# Generated by `gw apply` — DO NOT EDIT ON THE BOX
net.ipv4.ip_forward = 1

# TPROXY requires loose/disabled reverse path filtering: the reply path for an
# intercepted flow does not match the kernel's idea of where it came from.
net.ipv4.conf.all.rp_filter = 0
net.ipv4.conf.default.rp_filter = 0
net.ipv4.conf.{{WAN_IF}}.rp_filter = 0

# Single-NIC gateway: clients and the router share a segment, so without this
# the box sends ICMP redirects telling clients to bypass it entirely.
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0

{{IPV6_SYSCTL}}
# Throughput
{{BBR_SYSCTL}}net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_mtu_probing = 1

# A gateway holds far more conntrack entries than a workstation
net.netfilter.nf_conntrack_max = 131072
net.nf_conntrack_max = 131072
fs.file-max = 1048576
