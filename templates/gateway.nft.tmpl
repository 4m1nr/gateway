#!/usr/sbin/nft -f
#
# GENERATED by `gw apply` from {{CONFIG_PATH}} at {{GENERATED_AT}}
# DO NOT EDIT ON THE BOX — edit gateway.toml in the repo and re-apply.
#
# Two-layer policy:
#   this file  — decides WHETHER a client is intercepted
#   Xray       — decides WHERE an intercepted flow goes (proxy/direct/block)
#
# Fail-closed by construction: the forward chain has no accept path for
# @proxy_clients. If Xray is not listening, TPROXY does not match, the packet
# falls through to the terminal drop. There is no fallback to leak through.

define WAN         = "{{WAN_IF}}"
define LAN         = {{LAN_CIDR}}
define BOX         = {{BOX_IP}}
define ROUTER      = {{ROUTER}}
define TAILNET     = 100.64.0.0/10
define TPROXY_PORT = {{TPROXY_PORT}}
define MARK_TPROXY = {{MARK_TPROXY}}
define MARK_XRAY   = {{MARK_XRAY}}

# add-then-delete: makes the reload atomic and idempotent
table inet gateway
delete table inet gateway

table inet gateway {

    # ---------------------------------------------------------------- sets --
    set proxy_clients {
        type ipv4_addr
        flags interval
        comment "intercepted by Xray (plain proxy clients and all profiles)"
{{ELEM_PROXY}}    }

    set direct_clients {
        type ipv4_addr
        flags interval
        comment "forwarded straight to the router, never touched"
{{ELEM_DIRECT}}    }

    set blocked_clients {
        type ipv4_addr
        flags interval
        comment "dropped at the gateway"
{{ELEM_BLOCKED}}    }

    set bypass_dst {
        type ipv4_addr
        flags interval
        comment "destinations that must never enter the tunnel"
{{ELEM_BYPASS}}    }

    # ------------------------------------------------------------- divert --
    # Packets belonging to an already-established transparent socket. Without
    # this the first packet of a connection works and every subsequent one is
    # routed normally — the classic "it half works" TPROXY failure.
    chain divert {
        type filter hook prerouting priority mangle - 10; policy accept;
        meta l4proto tcp socket transparent 1 meta mark set $MARK_TPROXY accept
    }

    # ---------------------------------------------------------- prerouting --
    chain prerouting {
        type filter hook prerouting priority mangle; policy accept;

        iif lo return
        # LAN, tailnet, reserved space: local business, stays local
        ip daddr @bypass_dst return
{{IPV6_PREROUTING}}
        ip saddr @blocked_clients drop

        # explicit opt-out wins over everything below
        ip saddr @direct_clients return

        # the interception itself (includes 100.64.0.0/10 when tailnet egress
        # is proxied, which is what puts exit-node traffic in the tunnel)
        meta l4proto { tcp, udp } ip saddr @proxy_clients \
            meta mark set $MARK_TPROXY tproxy ip to 127.0.0.1:$TPROXY_PORT accept

        # Neither of these ever forwards traffic through us, but they are inside
        # $LAN and so would otherwise be caught by the catch-all below.
        ip saddr { $BOX, $ROUTER } return

        # Catch-all for the rest of the LAN. Only traffic that is actually
        # being forwarded reaches this chain, so this matches exactly the
        # devices that pointed their default gateway at this box — a device
        # that never opted in never sends us a packet to match.
{{PREROUTING_DEFAULT}}    }

    # -------------------------------------------------------------- output --
    # This is what puts the BOX'S OWN traffic through the tunnel.
    chain output {
        type route hook output priority mangle; policy accept;

        oif lo return
        # Xray's own sockets — belt (SO_MARK set on every outbound) and
        # braces (uid). Either one alone prevents the loop; both is cheap.
        meta mark $MARK_XRAY return
        meta skuid "xray" return

        ip daddr @bypass_dst return
{{IPV6_OUTPUT}}
        # NTP goes direct, always. TLS and REALITY both fail on a wrong clock,
        # so a tunnelled time sync is an unrecoverable boot dependency.
        udp dport 123 return

        jump exceptions
        jump lifeline

        meta l4proto { tcp, udp } meta mark set $MARK_TPROXY
    }

    # ---------------------------------------------------------- exceptions --
    # Local processes that must talk to the internet directly. `accept` here is
    # terminal for the hook, so the packet never reaches the marking rule.
    # Matching is by systemd cgroup, which is the only reliable handle on a
    # daemon that runs as root and talks to arbitrary addresses.
    chain exceptions {
{{ELEM_EXCEPTIONS}}    }

    # Runtime-toggled by gw-health. Empty in normal operation; when the tunnel
    # has been down long enough to strand you, the watchdog drops tailscaled in
    # here so remote admin comes back. Flushed again on recovery.
    chain lifeline {
    }

    # --------------------------------------------------------------- input --
    chain input {
        type filter hook input priority filter; policy drop;

        iif lo accept
        ct state established,related accept
        ct state invalid drop

        # TPROXY-delivered packets arrive here as "local" traffic
        meta mark $MARK_TPROXY accept

        icmp type echo-request limit rate 5/second accept
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, \
                      parameter-problem, echo-request, nd-neighbor-solicit, \
                      nd-neighbor-advert, nd-router-advert } accept

        iifname "tailscale0" accept
        # Tailscale's WireGuard listener
        udp dport 41641 accept

        # DNS for the LAN (AdGuard Home)
        ip saddr $LAN meta l4proto { tcp, udp } th dport {{DNS_PORT}} accept
{{INPUT_SSH}}{{INPUT_UI}}{{INPUT_WEB}}
        counter comment "dropped-input"
    }

    # ------------------------------------------------------------- forward --
    chain forward {
        type filter hook forward priority filter; policy drop;
{{IPV6_FORWARD}}
        # Clamp to the real path MTU. XHTTP inside TLS inside whatever your ISP
        # does leaves less room than clients assume, and the symptom is
        # "small pages load, big ones hang".
        tcp flags syn tcp option maxseg size set rt mtu

        ct state established,related accept
        ct state invalid drop

        ip saddr @blocked_clients drop

        # opted-out clients: plain NAT out to the router
        ip saddr @direct_clients accept

        # subnet router: tailnet <-> LAN
        iifname "tailscale0" accept
        oifname "tailscale0" accept

        # KILL SWITCH. Anything from a proxied client that reached this chain
        # was NOT intercepted, which means Xray is down. Drop it — never let it
        # fall back to a direct connection.
        ip saddr @proxy_clients counter drop comment "killswitch"
{{FORWARD_DEFAULT}}
        counter comment "dropped-forward"
    }

    # --------------------------------------------------------------- nat ----
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        # Only non-intercepted traffic ever reaches here; proxied flows are
        # delivered locally to Xray and leave with the box's own address.
        oifname $WAN ip saddr @direct_clients masquerade
        oifname $WAN ip saddr $TAILNET masquerade
{{POSTROUTING_DEFAULT}}
    }
}
