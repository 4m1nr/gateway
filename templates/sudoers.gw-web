# Generated by `gw apply` — installed to /etc/sudoers.d/gw-web after visudo -c.
#
# The dashboard's entire privilege surface. One command, no arguments, no
# wildcards: everything the web process wants to do is described in a JSON
# request on stdin and re-validated by that script as root.
#
# Do not widen this to `gw *`. The point of the indirection is that a
# compromised web process cannot ask for anything web-action.py does not
# already implement and check.
Defaults:gwweb !requiretty
Defaults:gwweb !syslog
gwweb ALL=(root) NOPASSWD: /usr/local/lib/gateway/web-action.py
