{
  "log": {
    "loglevel": "warning"
  },
  "api": {
    "tag": "api",
    "services": [
      "StatsService"
    ]
  },
  "dns": {
    "servers": [
      {
        "address": "178.22.122.100",
        "domains": [
          "domain:example.com",
          "domain:backup.example.com"
        ],
        "skipFallback": false
      },
      {
        "address": "178.22.122.100",
        "domains": [
          "geosite:private",
          "geosite:category-ir",
          "domain:ir"
        ],
        "expectIPs": [
          "geoip:private",
          "geoip:ir"
        ],
        "skipFallback": true
      },
      {
        "address": "185.51.200.2",
        "domains": [
          "geosite:private",
          "geosite:category-ir",
          "domain:ir"
        ],
        "expectIPs": [
          "geoip:private",
          "geoip:ir"
        ],
        "skipFallback": true
      },
      "https://1.1.1.1/dns-query",
      "https://8.8.8.8/dns-query"
    ],
    "queryStrategy": "UseIPv4",
    "disableCache": false,
    "tag": "dns-in"
  },
  "inbounds": [
    {
      "tag": "api",
      "listen": "127.0.0.1",
      "port": 10085,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      }
    },
    {
      "tag": "tproxy-in",
      "port": 12345,
      "protocol": "dokodemo-door",
      "settings": {
        "network": "tcp,udp",
        "followRedirect": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    },
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    },
    {
      "tag": "http-in",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {},
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "example.com",
            "port": 443,
            "users": [
              {
                "id": "11112222-3333-4444-5555-666677778888",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "xhttpSettings": {
          "host": "example.com",
          "path": "/xhttp",
          "mode": "auto"
        },
        "realitySettings": {
          "serverName": "example.com",
          "fingerprint": "chrome",
          "publicKey": "gTestPublicKeyValue123",
          "shortId": "",
          "spiderX": "/"
        },
        "sockopt": {
          "mark": 255,
          "domainStrategy": "UseIPv4",
          "tcpcongestion": "bbr",
          "tcpNoDelay": true
        }
      },
      "tag": "proxy"
    },
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "backup.example.com",
            "port": 443,
            "users": [
              {
                "id": "99998888-7777-6666-5555-444433332222",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "xhttpSettings": {
          "host": "backup.example.com",
          "path": "/alt",
          "mode": "packet-up"
        },
        "tlsSettings": {
          "serverName": "backup.example.com",
          "fingerprint": "chrome",
          "alpn": [
            "h2",
            "http/1.1"
          ],
          "allowInsecure": false
        },
        "sockopt": {
          "mark": 255,
          "domainStrategy": "UseIPv4",
          "tcpcongestion": "bbr",
          "tcpNoDelay": true
        }
      },
      "tag": "fallback"
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      },
      "streamSettings": {
        "sockopt": {
          "mark": 255,
          "tcpcongestion": "bbr",
          "tcpNoDelay": true
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "api"
        ],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "source": [
          "192.168.1.99"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "source": [
          "192.168.1.60"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:private",
          "geosite:category-ir"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": [
          "geoip:private",
          "geoip:ir"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "tunnel"
      }
    ],
    "balancers": [
      {
        "tag": "tunnel",
        "selector": [
          "proxy",
          "fallback"
        ],
        "strategy": {
          "type": "leastPing"
        }
      }
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 4,
        "connIdle": 300,
        "uplinkOnly": 0,
        "downlinkOnly": 0
      }
    },
    "system": {
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "stats": {},
  "burstObservatory": {
    "subjectSelector": [
      "proxy",
      "fallback"
    ],
    "pingConfig": {
      "destination": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "timeout": "10s",
      "sampling": 3
    }
  }
}
