# Generated by `gw apply` — DO NOT EDIT ON THE BOX
[Match]
Name=eth0

[Network]
DHCP=ipv4
# The box resolves through its own AdGuard instance, so its lookups are
# filtered and split exactly like the LAN's.
DNS=127.0.0.1
IPv6AcceptRA=no
LinkLocalAddressing=no

[DHCPv4]
UseDNS=no
UseDomains=no

[Link]
RequiredForOnline=routable
