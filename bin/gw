#!/usr/bin/env bash
# gw — the only command you should need on this box.
#
#   gw init          interview -> gateway.toml (parses a vless:// link)
#   gw render        generate build/ from gateway.toml (safe, no changes)
#   gw diff          show what apply would change
#   gw apply         render, diff, install, reload
#   gw enable        enable the whole stack to start on boot
#   gw disable       stop the stack and remove it from boot
#   gw restart       restart the whole stack
#   gw status        what is running and whether the tunnel is up
#   gw check         end-to-end verification, including leak tests
#   gw diag [ip]     why a client's traffic is or is not being intercepted
#   gw trace <ip>    follow one client's packets rule by rule, live
#   gw history [h]   what happened while you were not looking (intermittent faults)
#   gw bench         find the throughput bottleneck
#   gw client        add/remove/list per-client policy
#   gw job           add/remove/list scheduled jobs
#   gw web-passwd    set the dashboard password
#   gw update        all | services | xray | adguard | geo | packages | --check
#   gw panic         disable interception, plain NAT, keep the LAN online
#   gw logs          follow the relevant journals
set -euo pipefail

# nft, sysctl, ip, visudo and useradd all live in /usr/sbin, which is NOT in
# every root PATH — a plain `su`, or a root shell whose profile never added it,
# has only /usr/bin. Calling them by bare name then fails in ways that look
# like something else entirely: `gw status` reported "firewall not loaded"
# purely because it could not find nft, while `sudo gw apply` worked because
# sudo's secure_path does include /usr/sbin.
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"
export PATH

# Resolve the repo root through symlinks. The documented install symlinks
# /usr/local/bin/gw -> /opt/gateway/bin/gw, and $BASH_SOURCE is the symlink
# path, not its target — so without this the root resolves to /usr/local and
# every "$REPO/lib/..." lookup lands in the wrong tree.
# GW_REPO overrides it for anything unusual.
gw_resolve_repo() {
  local self="$1" target
  while [ -L "$self" ]; do
    target="$(readlink "$self")"
    case "$target" in
      /*) self="$target" ;;
      *)  self="$(dirname "$self")/$target" ;;
    esac
  done
  (cd "$(dirname "$self")/.." && pwd)
}
REPO="${GW_REPO:-$(gw_resolve_repo "${BASH_SOURCE[0]}")}"

for _need in nft ip; do
  command -v "$_need" >/dev/null 2>&1 || {
    printf '\033[31m[x]\033[0m required command %s not found on PATH.\n' "$_need" >&2
    printf '    PATH=%s\n' "$PATH" >&2
    exit 1
  }
done
unset _need

if [ ! -f "$REPO/lib/render.py" ]; then
  printf '\033[31m[x]\033[0m could not locate the gateway repo (looked in %s).\n' "$REPO" >&2
  printf '    Set GW_REPO=/path/to/gateway, or run bin/gw from the checkout.\n' >&2
  exit 1
fi
CONFIG="${GW_CONFIG:-$REPO/gateway.toml}"
BUILD="$REPO/build"
export PYTHONPATH="$REPO/lib"
PY=python3

AGH_YAML=/opt/AdGuardHome/AdGuardHome.yaml
# gateway.target is the umbrella; the rest are its members. tailscaled is
# deliberately absent — it is Wanted by the target but not PartOf it, so
# restarting the stack cannot drop the session you are managing it over.
STACK=(gateway.target gw-network.service xray.service gw-web.service gw-health.timer gw-geoupdate.timer gw-update.timer)
NFT_LIVE=/etc/nftables.d/gateway.nft

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
info() { printf '%s==>%s %s\n' "$c_grn" "$c_off" "$*"; }
warn() { printf '%s[!]%s %s\n' "$c_yel" "$c_off" "$*" >&2; }
die()  { printf '%s[x]%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "$1 needs root (try: sudo gw $1)"; }

# Read one value from the rendered env. Sourced in a subshell rather than
# grepped, so quoting is handled by the shell that wrote it.
gw_env() {
  [ -f /usr/local/lib/gateway/env ] || return 0
  ( . /usr/local/lib/gateway/env; eval "printf '%s' \"\${$1:-}\"" )
}

# ---------------------------------------------------------------- render ----
cmd_render() {
  $PY "$REPO/lib/render.py" "$CONFIG" "$BUILD"
}

# ------------------------------------------------------------------ diff ----
# Compares the staged tree against the live filesystem. Returns 1 if anything
# differs, which is what apply uses to decide whether a reload is needed.
cmd_diff() {
  # Always render. This used to render only when build/ was missing, so after
  # the first apply it compared last time's build tree against the files
  # installed from that very tree — identical by construction. `gw diff` then
  # reported "no changes" no matter what you had just edited in gateway.toml,
  # which is worse than no diff at all: it actively tells you your edit did
  # nothing.
  cmd_render >/dev/null \
    || die "render failed. Run 'gw render' to see the error (and note that
    writing build/ needs write access to $REPO)."
  local changed=0
  while IFS= read -r -d '' staged; do
    local rel="${staged#"$BUILD"/}"
    case "$rel" in adguard-overrides.json|tailscale-args) continue ;; esac
    local live="/$rel"
    if [ ! -f "$live" ]; then
      printf '%snew%s      %s\n' "$c_grn" "$c_off" "$live"; changed=1
    elif ! diff -q "$live" "$staged" >/dev/null; then
      printf '%schanged%s  %s\n' "$c_yel" "$c_off" "$live"
      diff -u --color=always "$live" "$staged" | sed '1,2d;s/^/    /' || true
      changed=1
    fi
  done < <(find "$BUILD" -type f -print0)
  [ "$changed" -eq 0 ] && info "no changes"
  return $changed
}

# ----------------------------------------------------------------- apply ----
cmd_apply() {
  local dry=0
  [ "${1:-}" = "--dry-run" ] && dry=1
  need_root apply

  info "rendering from $CONFIG"
  cmd_render

  # The nftables ruleset references the xray user by name; nft resolves it at
  # load time, so the account has to exist before the firewall is loaded.
  if ! id xray >/dev/null 2>&1; then
    info "creating the xray system user"
    useradd --system --no-create-home --shell /usr/sbin/nologin xray
  fi

  info "changes to be applied:"
  cmd_diff || true
  if [ "$dry" -eq 1 ]; then info "dry run — nothing written"; return 0; fi

  # An OnCalendar systemd cannot parse does not fail loudly: the timer unit
  # loads, never fires, and the setting reads as if it worked. Checked before
  # anything is installed, so a typo cannot leave a dead timer behind.
  local cal_unit="$BUILD/etc/systemd/system/gw-update.timer" cal
  if [ -f "$cal_unit" ] && command -v systemd-analyze >/dev/null 2>&1; then
    cal=$(sed -n 's/^OnCalendar=//p' "$cal_unit")
    systemd-analyze calendar "$cal" >/dev/null 2>&1 \
      || die "system.auto_update_schedule = \"$cal\" is not a valid systemd
    OnCalendar expression. Try: weekly, daily, or \"Sun 04:00\"."
  fi

  info "installing files"
  while IFS= read -r -d '' staged; do
    local rel="${staged#"$BUILD"/}"
    case "$rel" in adguard-overrides.json|tailscale-args) continue ;; esac
    local live="/$rel" mode=644
    # Most specific first: a `*` in a case glob matches `/` too, so the
    # generic gateway/*.sh pattern also matches gateway/jobs/*.sh and would
    # install job scripts world-readable. They run as root and may hold
    # credentials, so they are 700.
    case "$rel" in
      usr/local/lib/gateway/jobs/*.sh) mode=700 ;;
      usr/local/lib/gateway/*.sh|usr/local/lib/gateway/*.py) mode=755 ;;
      etc/sudoers.d/*) mode=440 ;;
    esac
    install -D -m "$mode" "$staged" "$live"
  done < <(find "$BUILD" -type f -print0)

  # A unit that stopped being rendered has to stop being installed. Otherwise
  # turning the scheduled updater off leaves it enabled and firing on the old
  # schedule: the setting looks like it worked and changes nothing.
  local stale
  for stale in gw-update.timer gw-update.service; do
    if [ ! -f "$BUILD/etc/systemd/system/$stale" ] \
       && [ -f "/etc/systemd/system/$stale" ]; then
      info "removing $stale (no longer in the config)"
      systemctl disable --now "$stale" >/dev/null 2>&1 || true
      rm -f "/etc/systemd/system/$stale"
    fi
  done

  info "applying sysctl"
  sysctl --system >/dev/null

  if [ -f "$BUILD/etc/sudoers.d/gw-web" ]; then
    info "validating the sudoers fragment"
    # A syntax error in /etc/sudoers.d can make sudo refuse to run at all, so
    # this is checked before it is anywhere near /etc.
    visudo -cf "$BUILD/etc/sudoers.d/gw-web" >/dev/null \
      || die "generated sudoers file is invalid — refusing to install it"
  fi

  # Debian's nftables.service loads /etc/nftables.conf, which begins with
  # `flush ruleset` — it would wipe our table out from under gw-network, which
  # stays "active" (Type=oneshot, RemainAfterExit) while its rules quietly
  # vanish. Two units cannot both own the ruleset; gw-network owns it.
  if systemctl cat nftables.service >/dev/null 2>&1; then
    if systemctl is-enabled --quiet nftables.service 2>/dev/null \
       || systemctl is-active --quiet nftables.service 2>/dev/null; then
      warn "nftables.service is active/enabled; it flushes the whole ruleset."
      warn "Masking it — gw-network manages /etc/nftables.d/gateway.nft instead."
      systemctl disable --now nftables.service >/dev/null 2>&1 || true
      systemctl mask nftables.service >/dev/null 2>&1 || true
    fi
  fi

  info "validating the ruleset before loading it"
  nft -c -f "$NFT_LIVE" || die "nftables ruleset rejected — nothing was reloaded"

  if [ -x /usr/local/bin/xray ]; then
    info "validating the Xray config"
    /usr/local/bin/xray run -test -config /usr/local/etc/xray/config.json >/dev/null \
      || die "Xray rejected its config — nothing was reloaded"
  fi

  systemctl daemon-reload

  # Keep /usr/local/bin/gw pointing INTO the repo. If it is a copy instead of
  # a symlink, `git pull` updates the checkout and changes nothing about the
  # command you actually run: every fix you pull looks like it did not work,
  # and the only evidence is that the output never changes.
  local link=/usr/local/bin/gw
  if [ ! -L "$link" ] || [ "$(readlink -f "$link")" != "$(readlink -f "$REPO/bin/gw")" ]; then
    if [ -e "$link" ] && [ ! -L "$link" ]; then
      warn "$link is a copy, not a symlink — it has been surviving your pulls"
      mv -f "$link" "$link.bak"
      warn "the old copy is at $link.bak"
    fi
    ln -sfn "$REPO/bin/gw" "$link"
    info "$link -> $REPO/bin/gw"
  fi

  info "enabling the gateway stack for boot"
  enable_stack

  # `gw panic` leaves a blanket-masquerade table behind. Applying a real
  # config must remove it, or the box keeps a stale NAT path that nothing
  # in the generated ruleset knows about.
  if nft list table ip gwpanic >/dev/null 2>&1; then
    info "clearing the panic-mode NAT table"
    nft delete table ip gwpanic 2>/dev/null || true
  fi

  info "reloading policy routing and firewall"
  # restart, not `enable --now`: the unit is usually already running and would
  # otherwise keep serving the previous ruleset.
  systemctl restart gw-network.service

  if systemctl list-unit-files gw-tailscale-exception.service >/dev/null 2>&1 \
     && [ -f /etc/systemd/system/gw-tailscale-exception.service ]; then
    systemctl enable --now gw-tailscale-exception.service >/dev/null 2>&1 || true
  fi

  if [ -x /usr/local/bin/xray ]; then
    info "restarting Xray"
    systemctl enable xray >/dev/null 2>&1 || true
    systemctl restart xray
  else
    warn "xray is not installed yet — run scripts/10-xray.sh"
  fi

  if [ -f "$AGH_YAML" ]; then
    info "merging AdGuard Home settings"
    $PY "$REPO/lib/agh_merge.py" "$AGH_YAML" "$BUILD/adguard-overrides.json"
    systemctl restart AdGuardHome 2>/dev/null || true
    # Undo a `gw panic` DNS fallback, but only once AdGuard is actually
    # answering — pointing at a dead resolver is what panic was rescuing us
    # from in the first place.
    if [ -f /etc/resolv.conf.gw-bak ]; then
      sleep 2
      if getent ahostsv4 example.com >/dev/null 2>&1 \
         || dig +short +time=3 +tries=1 @127.0.0.1 example.com >/dev/null 2>&1; then
        printf '# Managed by gw — this box resolves through its own AdGuard instance\nnameserver 127.0.0.1\noptions edns0\n' \
          > /etc/resolv.conf
        rm -f /etc/resolv.conf.gw-bak
        info "restored /etc/resolv.conf to the local resolver"
      else
        warn "AdGuard is not answering yet — leaving the panic DNS fallback in place"
      fi
    fi
  else
    warn "AdGuard Home is not set up yet — run scripts/20-adguard.sh"
  fi

  systemctl start gateway.target

  info "verifying"
  sleep 3
  /usr/local/lib/gateway/health.sh || true
  cmd_status
}

# ----------------------------------------------------------------- boot ----
# Enabling gateway.target alone is not enough: [Install] symlinks are created
# by enabling each member, and the target's Wants= only pulls in units that
# exist. Enabling both is what makes a cold boot come up complete.
enable_stack() {
  # Only enable what is actually installed: gw-web.service is absent when the
  # dashboard is disabled, and `systemctl enable` on a missing unit fails the
  # whole call.
  local units=()
  local u
  for u in "${STACK[@]}"; do
    if [ -f "/etc/systemd/system/$u" ]; then
      units+=("$u")
    fi
  done
  if [ "${#units[@]}" -eq 0 ]; then
    warn "no gateway units are installed yet"
    return 0
  fi
  systemctl enable "${units[@]}" >/dev/null 2>&1 \
    || warn "some units could not be enabled — check 'systemctl status gateway.target'"
  # AdGuard installs its own unit; ours is a drop-in on top of it.
  if systemctl cat AdGuardHome.service >/dev/null 2>&1; then
    systemctl enable AdGuardHome.service >/dev/null 2>&1 || true
  fi
  if systemctl cat tailscaled.service >/dev/null 2>&1; then
    systemctl enable tailscaled.service >/dev/null 2>&1 || true
  fi
  # Boot with a wrong clock and TLS fails before chrony has stepped it. This is
  # what gives time-sync.target — and so xray.service's ordering — any meaning.
  if systemctl cat chrony-wait.service >/dev/null 2>&1; then
    systemctl enable chrony-wait.service >/dev/null 2>&1 || true
  fi
}

cmd_enable() {
  need_root enable
  enable_stack
  systemctl start gateway.target
  info "gateway.target enabled — the stack now starts on boot"
  cmd_status
}

cmd_disable() {
  need_root disable
  warn "This stops the tunnel AND the firewall. Proxied clients lose"
  warn "connectivity entirely; they do not fall back to a direct path."
  warn "For a working-but-unproxied LAN, use 'gw panic' instead."
  read -r -p "continue? [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]] || die "aborted"
  systemctl stop gateway.target
  systemctl disable "${STACK[@]}" >/dev/null 2>&1 || true
  info "gateway.target disabled — nothing will start on the next boot"
}

cmd_restart() {
  need_root restart
  # PartOf= on each member makes this propagate; tailscaled is excluded on
  # purpose so remote access survives.
  systemctl restart gateway.target
  sleep 3
  cmd_status
}

# ---------------------------------------------------------------- status ----
cmd_status() {
  local tunnel; tunnel=$(cat /run/gateway/tunnel 2>/dev/null || echo unknown)
  local fails;  fails=$(cat /run/gateway/fails 2>/dev/null || echo 0)
  local life;   life=$(cat /run/gateway/lifeline 2>/dev/null || echo 0)

  local detail
  detail=$(cat /run/gateway/detail 2>/dev/null || true)
  case "$tunnel" in
    up)   printf 'gateway     %sOK%s (intercepted traffic reaches the tunnel)\n' "$c_grn" "$c_off" ;;
    degraded)
          # The distinction that matters: Xray is fine, the packets are not
          # getting to it. Reporting this as "tunnel down" sends you to the
          # wrong half of the system.
          printf 'gateway     %sDEGRADED%s — tunnel up, interception broken (%s failed probes)\n' \
            "$c_red" "$c_off" "$fails" ;;
    down) printf 'gateway     %sDOWN%s (%s consecutive failed probes)\n' "$c_red" "$c_off" "$fails" ;;
    *)    printf 'gateway     %sunknown%s (health check has not run yet)\n' "$c_yel" "$c_off" ;;
  esac
  [ -n "$detail" ] && printf '%s  %s%s\n' "$c_dim" "$detail" "$c_off"
  [ "$life" = "1" ] && printf 'lifeline    %sENGAGED%s — tailscaled is bypassing the tunnel\n' "$c_yel" "$c_off"

  # Which code is actually running. A stale copy of this script at
  # /usr/local/bin/gw survives every git pull, so the box keeps running an old
  # CLI while the checkout says otherwise — and every fix you pull appears to
  # have done nothing at all.
  local head self
  head=$(git -C "$REPO" log -1 --format='%h %cs' 2>/dev/null || echo "not a git checkout")
  printf '%sversion     %s  (%s)%s\n' "$c_dim" "$head" "$REPO" "$c_off"
  self=$(command -v gw 2>/dev/null || true)
  if [ -n "$self" ] \
     && [ "$(readlink -f "$self" 2>/dev/null)" != "$(readlink -f "$REPO/bin/gw" 2>/dev/null)" ]; then
    warn "$self is not $REPO/bin/gw — you are running a stale copy, and"
    warn "git pull will not change it. Fix: sudo ln -sfn $REPO/bin/gw $self"
  fi

  if systemctl cat gateway.target >/dev/null 2>&1; then
    printf '%-11s %s (boot: %s)\n' "stack" \
      "$(systemctl is-active gateway.target 2>/dev/null || echo inactive)" \
      "$(systemctl is-enabled gateway.target 2>/dev/null || echo disabled)"
  else
    printf '%-11s %snot installed%s — run: sudo gw apply\n' "stack" "$c_yel" "$c_off"
  fi

  for u in xray gw-network AdGuardHome tailscaled; do
    if systemctl list-unit-files "$u.service" >/dev/null 2>&1 && \
       systemctl cat "$u.service" >/dev/null 2>&1; then
      printf '%-11s %s (boot: %s)\n' "$u" \
        "$(systemctl is-active "$u" 2>/dev/null || echo missing)" \
        "$(systemctl is-enabled "$u" 2>/dev/null || echo disabled)"
    fi
  done

  # How long Xray has been up, because a restart is invisible after the fact
  # and is itself an outage: it drops every live connection on every client.
  # A client that "lost the internet for a moment" a few minutes ago, next to
  # an xray that has only been up a few minutes, is the whole explanation.
  # Only while it is actually running: ActiveEnterTimestamp survives the stop,
  # so an inactive unit would otherwise report a cheerful uptime.
  local started epoch age
  started=""
  systemctl is-active --quiet xray 2>/dev/null \
    && started=$(systemctl show xray -p ActiveEnterTimestamp --value 2>/dev/null || true)
  # `date -d ""` does not fail — GNU date reads an empty string as midnight
  # today, which would report a plausible-looking uptime for a dead service.
  epoch=0
  [ -n "$started" ] && epoch=$(date -d "$started" +%s 2>/dev/null || echo 0)
  if [ "$epoch" -gt 0 ]; then
    age=$(( $(date +%s) - epoch ))
    if [ "$age" -lt 900 ]; then
      printf '%-11s %sstarted %sm %ss ago%s — anything connected before that was dropped\n' \
        "xray up" "$c_yel" "$((age / 60))" "$((age % 60))" "$c_off"
    else
      printf '%s%-11s %sh %sm%s\n' "$c_dim" "xray up" "$((age / 3600))" \
        "$(((age % 3600) / 60))" "$c_off"
    fi
  fi

  if ! command -v nft >/dev/null 2>&1; then
    printf 'firewall    %sunknown%s — nft is not on PATH, cannot tell\n' "$c_yel" "$c_off"
  elif nft list table inet gateway >/dev/null 2>&1; then
    printf 'firewall    loaded\n'
    local proxied drops
    proxied=$(gw_set_elements proxy_clients)
    # There are two killswitch rules (listed clients and the LAN catch-all), so
    # sum them — printf would otherwise reuse its format for the second value
    # and emit a stray line.
    drops=$(nft list chain inet gateway forward 2>/dev/null \
            | grep killswitch | grep -oE 'packets [0-9]+' \
            | awk '{s += $2} END {print s + 0}')
    local defpol
    defpol=$(gw_env DEFAULT_POLICY)
    printf '%s  default         : %s (any device whose gateway is this box)%s\n' \
      "$c_dim" "${defpol:-?}" "$c_off"
    printf '%s  intercepted     : %s%s\n' "$c_dim" "${proxied:-none}" "$c_off"
    local profs
    profs=$(gw_env PROFILES)
    [ -n "$profs" ] && printf '%s  profiles        : %s%s\n' "$c_dim" "$profs" "$c_off"
    printf '%s  killswitch drops: %s%s\n' "$c_dim" "${drops:-0}" "$c_off"
  else
    printf 'firewall    %snot loaded%s\n' "$c_red" "$c_off"
  fi

  if [ -f /etc/gateway/web.json ]; then
    local wport wscheme
    wport=$(sed -n 's/.*"port": *\([0-9]*\).*/\1/p' /etc/gateway/web.json)
    wscheme=http; grep -q '"tls": *true' /etc/gateway/web.json && wscheme=https
    printf 'dashboard   %s://%s:%s\n' "$wscheme" "$(gw_env BOX_IP)" "$wport"
  fi

  if command -v tailscale >/dev/null 2>&1; then
    local ts self health hline
    ts=$(tailscale status --peers=false 2>/dev/null || true)
    if [ -z "$ts" ]; then
      printf 'tailscale   %snot logged in, or tailscaled is not answering%s\n' \
        "$c_yel" "$c_off"
    else
      self=$(printf '%s\n' "$ts" | grep -v '^#' | grep -v '^$' | head -1)
      [ -n "$self" ] && printf 'tailscale   %s\n' "$self"
      # `head -3` used to cut this off one line into the "# Health check:"
      # header — printing the heading and hiding every warning underneath it,
      # which is the only part that says what is wrong.
      health=$(printf '%s\n' "$ts" | sed -n '/# Health check:/,$p' \
               | sed '1d; s/^#[[:space:]]*//; s/^-[[:space:]]*//' | grep -v '^$' || true)
      while IFS= read -r hline; do
        [ -n "$hline" ] && printf '%s  health: %s%s\n' "$c_yel" "$hline" "$c_off"
      done <<EOFHEALTH
$health
EOFHEALTH
    fi
  fi
}

# ----------------------------------------------------------------- check ----
cmd_check() { need_root check; "$REPO/scripts/90-verify.sh" "$@"; }

# ------------------------------------------------------------------ diag ----
# nft prints a set's elements across several lines once there are more than a
# few, so a single-line sed silently reports an empty set. Join first.
gw_set_elements() {
  # Tabs as well as newlines: nft wraps a long element list and indents the
  # continuation with tabs, so squeezing spaces alone leaves a ragged gap in
  # the middle of the list.
  nft list set inet gateway "$1" 2>/dev/null \
    | tr '\n\t' '  ' \
    | sed -n 's/.*elements = {\([^}]*\)}.*/\1/p' \
    | tr -s ' ' \
    | sed 's/^ //; s/ $//'
}

# Print "name: N packets" for every counted rule in a chain, and "-" for the
# ones that have not fired. An uncommented counter is reported by position so
# it still shows up rather than being dropped from the report.
gw_counters() {
  nft list chain inet gateway "$1" 2>/dev/null \
    | grep -E 'counter packets' \
    | awk '{
        pkts = ""; name = "";
        for (i = 1; i <= NF; i++) if ($i == "packets") { pkts = $(i+1); break }
        if (match($0, /comment "[^"]+"/)) {
          name = substr($0, RSTART + 9, RLENGTH - 10)
        } else {
          name = "(rule " ++n ")"
        }
        printf "  %-24s %s\n", name ":", (pkts == "0" ? "-" : pkts " packets")
      }'
}

# Answers "where does this client's traffic actually go?" from the counters,
# rather than from reasoning about the ruleset. Every decision point in
# prerouting is counted, so one of these numbers moving identifies the rule
# that claimed the packets.
cmd_diag() {
  need_root diag
  local client="${1:-}"

  printf '%s== ruleset ==%s\n' "$c_grn" "$c_off"
  if ! nft list table inet gateway >/dev/null 2>&1; then
    die "the gateway table is not loaded — run 'sudo gw apply'"
  fi
  gw_counters prerouting
  printf '\n%s== input (where intercepted packets are delivered) ==%s\n' "$c_grn" "$c_off"
  gw_counters input

  printf '\n%s== forward (traffic that was NOT intercepted) ==%s\n' "$c_grn" "$c_off"
  gw_counters forward

  printf '\n%s== policy routing ==%s\n' "$c_grn" "$c_off"
  ip rule list | sed 's/^/  /'
  printf '  table %s: %s\n' "$(gw_env RT_TABLE)" \
    "$(ip route show table "$(gw_env RT_TABLE)" 2>/dev/null | tr '\n' ' ')"

  printf '\n%s== interception sets ==%s\n' "$c_grn" "$c_off"
  for s in proxy_clients direct_clients blocked_clients; do
    printf '  %-16s %s\n' "$s" "$(gw_set_elements "$s")"
  done
  printf '  %-16s %s\n' "default" "$(gw_env DEFAULT_POLICY)"
  printf '  %-16s %s\n' "lan_cidr" "$(gw_env LAN_CIDR)"

  # The decisive test: ask the kernel what it does with a packet shaped like
  # the client's, instead of reasoning about the rules.
  printf '\n%s== kernel routing decision ==%s\n' "$c_grn" "$c_off"
  local wan probe_dst
  wan=$(gw_env WAN_IF)
  probe_dst=1.1.1.1
  if [ -n "$client" ]; then
    printf '  forward (marked, as after tproxy):\n'
    local fwd
    # `|| true` matters: this command failing is a RESULT, not an error, and
    # under `set -e` it would otherwise abort the rest of the report.
    fwd=$(ip route get "$probe_dst" from "$client" iif "$wan" mark 1 2>&1 || true)
    printf '%s\n' "$fwd" | sed 's/^/    /'
    case "$fwd" in
      *"Invalid argument"*)
        printf '    %s^ EINVAL here means MARTIAN SOURCE: the kernel rejects this\n' "$c_red"
        printf '      client during reverse-path validation, which is exactly\n'
        printf '      where intercepted packets disappear.%s\n' "$c_off" ;;
      *"local "*) printf '    %s^ good: delivered locally, which is what TPROXY needs%s\n' "$c_grn" "$c_off" ;;
    esac

    # The lookup that validates the reverse path. It runs with mark 0, so it
    # ignores our fwmark rule and can land in another table entirely.
    printf '  reverse (validation, mark 0):\n'
    ip route get "$client" from "$probe_dst" 2>&1 | sed 's/^/    /' || true
  fi

  printf '  routing tables in play:\n'
  for tbl in $(ip rule list | sed -n 's/.*lookup \([a-z0-9]*\).*/\1/p' | sort -u); do
    printf '    table %s: %s\n' "$tbl" \
      "$(ip route show table "$tbl" 2>/dev/null | tr '\n' '|' | cut -c1-120)"
  done

  printf '  rp_filter:'
  for f in /proc/sys/net/ipv4/conf/*/rp_filter; do
    printf ' %s=%s' "$(basename "$(dirname "$f")")" "$(cat "$f")"
  done
  printf '\n'

  # -EXDEV drops land in these counters and nowhere else.
  if command -v nstat >/dev/null 2>&1; then
    printf '  kernel drops: %s\n' \
      "$(nstat -az 2>/dev/null \
         | grep -iE 'rpfilter|martian|InAddrErrors|InNoRoutes' \
         | awk '{printf "%s=%s ", $1, $2}')"
  fi

  printf '\n%s== forwarding ==%s\n' "$c_grn" "$c_off"
  printf '  ip_forward=%s rp_filter=%s send_redirects=%s\n' \
    "$(cat /proc/sys/net/ipv4/ip_forward)" \
    "$(cat /proc/sys/net/ipv4/conf/all/rp_filter)" \
    "$(cat /proc/sys/net/ipv4/conf/all/send_redirects)"

  # Tailscale checks BOTH families. `--advertise-exit-node` advertises ::/0 as
  # well as 0.0.0.0/0 — there is no v4-only exit node — so v6 forwarding off is
  # enough on its own to produce "Subnet routing is enabled, but IP forwarding
  # is disabled", on a box that forwards IPv4 perfectly well. The generic
  # wording sends people to check ip_forward, which is not the one that is off.
  local fwd6 fwd_file iface
  fwd6=$(cat /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || echo "n/a")
  printf '  ipv6 forwarding (all)=%s' "$fwd6"
  for fwd_file in /proc/sys/net/ipv4/conf/*/forwarding; do
    iface=$(basename "$(dirname "$fwd_file")")
    case "$iface" in all|default) continue ;; esac
    printf ' %s:v4=%s' "$iface" "$(cat "$fwd_file" 2>/dev/null || echo '?')"
  done
  printf '\n'
  if [ "$fwd6" = "0" ]; then
    printf '    %s^ this alone makes Tailscale report "IP forwarding is disabled"\n' "$c_yel"
    printf '      even with IPv4 forwarding on. Fix: sudo gw apply%s\n' "$c_off"
  fi
  printf '  xray listening: %s\n' \
    "$(ss -lntup 2>/dev/null | grep -c "$(gw_env TPROXY_PORT)") socket(s) on $(gw_env TPROXY_PORT)"

  if [ -n "$client" ]; then
    printf '\n%s== client %s ==%s\n' "$c_grn" "$client" "$c_off"
    printf '  in proxy_clients : %s\n' \
      "$(nft get element inet gateway proxy_clients "{ $client }" >/dev/null 2>&1 \
         && echo yes || echo 'no (covered by the LAN default if it is inside lan_cidr)')"
    printf '  in direct_clients: %s\n' \
      "$(nft get element inet gateway direct_clients "{ $client }" >/dev/null 2>&1 \
         && echo yes || echo no)"
    if command -v conntrack >/dev/null 2>&1; then
      printf '  conntrack        : %s entries\n' \
        "$(conntrack -L 2>/dev/null | grep -c "src=$client")"
    else
      printf '  conntrack        : (conntrack tool not installed)\n'
    fi
    printf '  recent in xray   :\n'
    journalctl -u xray -n 200 --no-pager -o cat 2>/dev/null \
      | grep "$client" | tail -5 | sed 's/^/    /' \
      || printf '    (none — its packets are not reaching Xray)\n'
  fi

  cat <<'HINT'

Reading this:
  lan-intercepted / listed-intercepted climbing  the client IS being proxied;
                                                 look at Xray, not the firewall
  poisoned-dns climbing                          the client is following a
                                                 poisoned DNS answer — point its
                                                 DNS at this box
  killswitch climbing                            traffic reached forward instead
                                                 of being intercepted
  bypass-local climbing                          the destination is being treated
                                                 as local
  all flat                                       the packets never arrive: check
                                                 the client's default gateway
HINT
}

# ----------------------------------------------------------------- trace ----
# Counters say which rules fired; they cannot say which rules ONE client's
# packets went through, or where they stopped. nftrace does exactly that:
# every chain, every rule, every verdict, for the packets you select.
cmd_trace() {
  need_root trace
  local client="${1:-}"
  local secs="${2:-20}"
  [ -n "$client" ] || die "usage: gw trace <client-ip> [seconds]"
  nft list table inet gateway >/dev/null 2>&1 \
    || die "the gateway table is not loaded — run 'sudo gw apply'"

  # insert, not add: tracing has to be switched on before any rule can decide
  # the packet's fate, so it belongs at the top of the chain.
  nft insert rule inet gateway prerouting ip saddr "$client" meta nftrace set 1 \
    || die "could not install the trace rule"

  cleanup_trace() {
    local h
    h=$(nft -a list chain inet gateway prerouting 2>/dev/null \
        | awk "/nftrace set 1/ && /$client/ {print \$NF}" | head -1)
    [ -n "$h" ] && nft delete rule inet gateway prerouting handle "$h" 2>/dev/null
    info "trace rule removed"
  }
  trap cleanup_trace EXIT INT TERM

  info "tracing $client for ${secs}s — generate traffic on that device now"
  printf '%s(each line is one rule the packet reached; the last line before a
' "$c_dim"
  printf ' gap is where it stopped)%s\n\n' "$c_off"
  timeout "$secs" nft monitor trace || true

  cleanup_trace
  trap - EXIT INT TERM
  cat <<'HINT'

Reading a trace:
  ...prerouting...tproxy...      the packet was handed to Xray
  ...input...accept              it reached the local socket
  ...input...drop / policy drop  it died in the input chain
  no output at all               the packet never reached this box: the client
                                 is not using it as a gateway
HINT
}

# ----------------------------------------------------------------- bench ----
# Halved throughput through a gateway usually has a boring cause. This measures
# the three that matter instead of guessing between them: the link, the CPU,
# and the tunnel itself.
cmd_bench() {
  need_root bench
  local wan; wan=$(gw_env WAN_IF)
  local socks; socks=$(gw_env SOCKS_PORT)
  local url="${1:-https://speed.cloudflare.com/__down?bytes=50000000}"

  printf '%s== link ==%s\n' "$c_grn" "$c_off"
  local speed duplex
  speed=$(cat "/sys/class/net/$wan/speed" 2>/dev/null || echo "?")
  duplex=$(cat "/sys/class/net/$wan/duplex" 2>/dev/null || echo "?")
  printf '  %s: %s Mb/s %s\n' "$wan" "$speed" "$duplex"
  if [ "$speed" != "?" ] && [ "$speed" -le 100 ] 2>/dev/null; then
    printf '  %s! One NIC carries intercepted traffic TWICE — in from the client\n' "$c_yel"
    printf '    and out to the internet — so a %s Mb/s link caps clients at about\n' "$speed"
    printf '    %s Mb/s. That alone explains a halving.%s\n' "$((speed / 2))" "$c_off"
  fi
  [ "$duplex" = "half" ] && printf '  %s! HALF DUPLEX — almost always a bad cable or a forced port speed%s\n' "$c_red" "$c_off"
  printf '  errors/drops: %s\n' \
    "$(awk -v i="$wan" '$1 ~ i {printf "rx_drop=%s tx_drop=%s", $5, $13}' /proc/net/dev 2>/dev/null)"

  printf '\n%s== cpu ==%s\n' "$c_grn" "$c_off"
  printf '  cores: %s   model: %s\n' "$(nproc)" \
    "$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1)"
  printf '  aes-ni: %s\n' \
    "$(grep -qm1 ' aes ' /proc/cpuinfo && echo yes \
       || echo 'NO — TLS is done in software, which is usually the ceiling on an old thin client')"

  printf '\n%s== throughput ==%s\n' "$c_grn" "$c_off"
  printf '  downloading 50 MB twice; this takes a moment...\n'

  # curl reports its own throughput, which is more honest than timing the
  # wrapper: it excludes DNS and connection setup and counts the bytes that
  # actually arrived. %{speed_download} is bytes/s.
  local direct tunnel dbytes tbytes cpu0 cpu1
  cpu0=$(awk '/^cpu /{print $2+$3+$4+$6+$7+$8, $5}' /proc/stat)

  # curl writes its -w output even when the transfer fails, so a `|| echo`
  # fallback would append a second pair and corrupt the parse. Take whatever
  # curl printed and validate it instead.
  local out
  out=$(gw_as_user xray curl -o /dev/null -s --max-time 120 \
          -w '%{speed_download} %{size_download}' "$url" 2>/dev/null) || true
  direct=$(printf '%s' "$out" | awk '{print $1+0}')
  dbytes=$(printf '%s' "$out" | awk '{print $2+0}')

  out=$(curl -o /dev/null -s --max-time 120 --socks5-hostname "127.0.0.1:$socks" \
          -w '%{speed_download} %{size_download}' "$url" 2>/dev/null) || true
  tunnel=$(printf '%s' "$out" | awk '{print $1+0}')
  tbytes=$(printf '%s' "$out" | awk '{print $2+0}')

  cpu1=$(awk '/^cpu /{print $2+$3+$4+$6+$7+$8, $5}' /proc/stat)

  # bytes/s -> Mb/s
  direct=$(awk -v v="$direct" 'BEGIN{ printf "%.1f", (v * 8) / 1000000 }')
  tunnel=$(awk -v v="$tunnel" 'BEGIN{ printf "%.1f", (v * 8) / 1000000 }')

  printf '  direct (bypassing the tunnel): %s Mb/s  (%s bytes)\n' "$direct" "$dbytes"
  printf '  through the tunnel           : %s Mb/s  (%s bytes)\n' "$tunnel" "$tbytes"
  printf '  cpu busy during the test     : %s\n' \
    "$(awk -v p="$cpu0" -v q="$cpu1" 'BEGIN{
         split(p, a, " "); split(q, b, " ")
         busy = b[1] - a[1]; idle = b[2] - a[2]; tot = busy + idle
         if (tot <= 0) { print "?"; exit }
         printf "%.0f%% of %d cores", busy * 100 / tot, 1
       }' )"

  awk -v d="$direct" -v t="$tunnel" -v s="$speed" 'BEGIN {
    if (d + 0 <= 0 || t + 0 <= 0) {
      print "  (a measurement failed - check connectivity, and see the byte counts above)"
      exit
    }
    r = t / d * 100
    printf "  tunnel is %.0f%% of direct\n", r
    if (r < 60) {
      print "  -> the TUNNEL is the bottleneck: CPU (see aes-ni above), the"
      print "     server, or the path to it. Not the LAN."
    } else if (s != "?" && d < s / 2 * 0.8) {
      print "  -> direct is already well under half the link speed, so the"
      print "     bottleneck is upstream of this box, not the gateway."
    } else {
      print "  -> the tunnel keeps up here, so a slower client is the LAN path:"
      print "     one NIC carries intercepted traffic twice."
    }
  }'


  cat <<'HINT'

If clients are slower than this box, the difference is the LAN leg, not Xray:
intercepted traffic crosses the single NIC twice. A second NIC (a USB 3.0
gigabit adapter) removes that ceiling entirely.
HINT
}

# ---------------------------------------------------------------- client ----
# --------------------------------------------------------------- history ----
# For faults that come and go.
#
# `gw diag` and `gw trace` only see the present. An outage that ended ten
# minutes ago leaves nothing for them to look at, so an intermittent fault
# defeats both: by the time anyone runs them, the box looks healthy — and it
# IS healthy, which is why guessing from a clean report goes nowhere.
#
# This reads back what was recorded while it happened. The first question is
# the one that halves the search: was the GATEWAY down when the client was?
cmd_history() {
  local hours=48 client="" arg
  for arg in "$@"; do
    case "$arg" in
      *.*.*.*) client="$arg" ;;
      *[!0-9]*) die "usage: gw history [hours] [client-ip]" ;;
      *) hours="$arg" ;;
    esac
  done
  local since="-${hours}h" line

  printf '%s== tunnel outages seen by the health probe (last %sh) ==%s\n' \
    "$c_grn" "$hours" "$c_off"
  local health
  health=$(journalctl -t gw-health --since "$since" --no-pager -o short-iso 2>/dev/null \
           | grep -E 'probe failed|INTERCEPTION|healthy again|lifeline|restarting xray|conntrack' \
           || true)
  if [ -n "$health" ]; then
    printf '%s\n' "$health" | sed 's/^/  /'
  else
    printf '  %snone. The probe ran every %ss and never failed.%s\n' \
      "$c_dim" "$(gw_env INTERVAL || true)" "$c_off"
    printf '  %sIf the client lost the internet inside this window, the tunnel was\n' "$c_dim"
    printf '   up while that happened: look between the client and this box\n'
    printf '   (DNS, wifi, the client gateway setting), not at the tunnel.%s\n' "$c_off"
  fi

  printf '\n%s== service restarts ==%s\n' "$c_grn" "$c_off"
  printf '  %severy xray restart drops every live connection on every client.%s\n' \
    "$c_dim" "$c_off"
  local unit n
  for unit in xray AdGuardHome tailscaled gw-web; do
    systemctl list-unit-files "$unit.service" >/dev/null 2>&1 || continue
    line=$(journalctl -u "$unit" --since "$since" --no-pager -o short-iso 2>/dev/null \
           | grep -E 'Started|Stopped|Main process exited|Scheduled restart|Failed with result' \
           || true)
    n=$(printf '%s' "$line" | grep -c 'Started' || true)
    printf '  %-12s %s start(s)\n' "$unit" "${n:-0}"
    [ -n "$line" ] && printf '%s\n' "$line" | tail -12 | sed 's/^/      /'
  done

  printf '\n%s== kernel complaints ==%s\n' "$c_grn" "$c_off"
  line=$(journalctl -k --since "$since" --no-pager -o short-iso 2>/dev/null \
         | grep -iE 'conntrack table full|nf_conntrack: table full|Out of memory|oom-kill|martian|Link is Down|link is not ready|carrier lost|TX unit hang|reset adapter' \
         || true)
  if [ -n "$line" ]; then
    printf '%s\n' "$line" | tail -25 | sed 's/^/  /'
    case "$line" in
      *"table full"*) printf '  %s^ conntrack filled: NEW connections were dropped while it was full.\n' "$c_red"
                      printf '    That looks exactly like "the internet stopped for a bit".%s\n' "$c_off" ;;
    esac
    case "$line" in
      *"ut of memory"*|*oom-kill*) printf '  %s^ the OOM killer ran. If it took xray, every connection died with it.%s\n' "$c_red" "$c_off" ;;
    esac
  else
    printf '  %snone%s\n' "$c_dim" "$c_off"
  fi

  printf '\n%s== pressure right now ==%s\n' "$c_grn" "$c_off"
  local cur max pct
  cur=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)
  max=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo 0)
  pct=0; [ "$max" -gt 0 ] && pct=$((cur * 100 / max))
  printf '  conntrack : %s/%s (%s%%)\n' "$cur" "$max" "$pct"
  [ "$pct" -ge 60 ] && printf '    %s^ high. A phone on QUIC opens a lot of UDP flows; raise\n' "$c_yel" \
    && printf '      net.netfilter.nf_conntrack_max, or shorten the UDP timeout.%s\n' "$c_off"
  printf '  memory    : %s\n' "$(free -h 2>/dev/null | awk '/^Mem:/{printf "%s total, %s available", $2, $7}')"
  printf '  xray rss  : %s\n' \
    "$(ps -o rss= -C xray 2>/dev/null | awk '{s+=$1} END{printf "%.0f MB", s/1024}')"
  printf '  load      : %s\n' "$(cut -d' ' -f1-3 /proc/loadavg)"
  printf '  uptime    : %s\n' "$(uptime -p 2>/dev/null || true)"

  # The ring buffer health.sh keeps in tmpfs: one line per probe, so an outage
  # that never tripped a threshold still leaves a trace.
  local hist=/run/gateway/history
  if [ -s "$hist" ]; then
    printf '\n%s== recorded samples ==%s (%s lines, oldest %s)\n' \
      "$c_grn" "$c_off" "$(wc -l < "$hist")" "$(head -1 "$hist" | cut -d' ' -f1)"
    printf '  %snon-up samples, newest last:%s\n' "$c_dim" "$c_off"
    line=$(grep -v ' up ' "$hist" | tail -20 || true)
    if [ -n "$line" ]; then printf '%s\n' "$line" | sed 's/^/  /'
    else printf '  %severy sample says up%s\n' "$c_dim" "$c_off"; fi
    printf '  %slast 5:%s\n' "$c_dim" "$c_off"
    tail -5 "$hist" | sed 's/^/  /'
  else
    printf '\n%s== recorded samples ==%s\n' "$c_grn" "$c_off"
    printf '  %snone yet (%s is written by the health timer; it starts empty\n' "$c_dim" "$hist"
    printf '   after a reboot and fills at one line per probe)%s\n' "$c_off"
  fi

  # The other half of the split. If the box was healthy the whole time, the
  # next question is whether the client was still talking to it at all — and
  # AdGuard already wrote that down, one line per query, with the client IP.
  # A gap here means the client stopped asking: it fell back to another
  # resolver, or it was off the wifi entirely. Neither is a gateway fault.
  printf '\n%s== DNS queries per hour%s ==%s\n' "$c_grn" \
    "$([ -n "$client" ] && printf ' from %s' "$client")" "$c_off"
  local agh="${GW_AGH_LOG:-/opt/AdGuardHome/data/querylog.json}"
  if [ -r "$agh" ]; then
    GW_CLIENT="$client" GW_HOURS="$hours" $PY - "$agh" "$agh.1" <<'PYLOG'
import json, os, sys, time
client = os.environ.get("GW_CLIENT") or ""
window = int(os.environ.get("GW_HOURS") or 48) * 3600
cutoff = time.time() - window
buckets = {}
for path in sys.argv[1:]:
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        continue
    with fh:
        for line in fh:
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if client and rec.get("IP") != client:
                continue
            stamp = (rec.get("T") or "")[:19]
            try:
                secs = time.mktime(time.strptime(stamp, "%Y-%m-%dT%H:%M:%S"))
            except ValueError:
                continue
            if secs < cutoff:
                continue
            buckets[stamp[:13]] = buckets.get(stamp[:13], 0) + 1
if not buckets:
    print("  no queries in this window" + (" from " + client if client else ""))
    print("  ^ if the client was online and using this box for DNS, there would")
    print("    be some. Check what resolver it is actually using.")
    raise SystemExit
hours = sorted(buckets)
widest = max(buckets.values())
start = time.strptime(hours[0] + ":00:00", "%Y-%m-%dT%H:%M:%S")
cursor = time.mktime(start)
end = time.mktime(time.strptime(hours[-1] + ":00:00", "%Y-%m-%dT%H:%M:%S"))
while cursor <= end:
    key = time.strftime("%Y-%m-%dT%H", time.localtime(cursor))
    count = buckets.get(key, 0)
    bar = "#" * max(1, count * 40 // widest) if count else ""
    flag = "" if count else "   <- silence"
    print("  %s  %6d %s%s" % (key.replace("T", " ") + ":00", count, bar, flag))
    cursor += 3600
PYLOG
  else
    printf '  %s%s is not readable — run this as root, or AdGuard query logging is off%s\n' \
      "$c_dim" "$agh" "$c_off"
  fi

  cat <<'HINT'

Reading this:
  outages listed, client dropped at the same time   the tunnel. Look at the
                                                    xray journal at that
                                                    timestamp.
  no outages, but xray restarted                    the restart WAS the outage.
                                                    Every connection dies with
                                                    it; the client notices, the
                                                    probe does not.
  no outages, no restarts                           the box was fine while the
                                                    client was not. Read the DNS
                                                    histogram next.
  DNS silent during the outage                      the client stopped asking
                                                    this box: it left the wifi,
                                                    or it fell back to another
                                                    resolver. Not a gateway
                                                    fault.
  DNS steady through the outage                     the client kept resolving
                                                    but could not move data —
                                                    the data path, not DNS.
  conntrack full / OOM                              cause found; both drop new
                                                    connections while they last.

Run it with the client IP to get that histogram: gw history 48 192.168.1.87
HINT
}

cmd_client() { $PY "$REPO/lib/clients.py" "$CONFIG" "$@"; }
cmd_job()    { $PY "$REPO/lib/jobs.py"    "$CONFIG" "$@"; }

# ------------------------------------------------------------- web-passwd ----
cmd_web_passwd() {
  need_root web-passwd
  $PY "$REPO/lib/web_passwd.py"
}

# ----------------------------------------------------------------- init ----
cmd_init() { $PY "$REPO/lib/init.py" "$REPO" "$CONFIG" "$@"; }

# ---------------------------------------------------------------- update ----
cmd_update() {
  need_root update
  local what="${1:-all}"
  shift || true

  case "$what" in
    --check|check)
      # Report only. Nothing here changes the box, so it is safe to run from a
      # cron job or just to see where you stand.
      printf '%s--- xray ---%s\n' "$c_grn" "$c_off"
      /usr/local/lib/gateway/xray-update.sh --check || true
      printf '%s--- adguard ---%s\n' "$c_grn" "$c_off"
      /usr/local/lib/gateway/adguard-update.sh --check || true
      printf '%s--- geodata ---%s\n' "$c_grn" "$c_off"
      /usr/local/lib/gateway/geoupdate.sh --check || true
      printf '%s--- packages ---%s\n' "$c_grn" "$c_off"
      apt_proxy_on
      apt-get update -qq 2>/dev/null || true
      apt-get -s upgrade 2>/dev/null | grep -E '^[0-9]+ upgraded' || echo "unknown"
      apt_proxy_off
      if command -v tailscale >/dev/null; then
        printf '%s--- tailscale ---%s\n' "$c_grn" "$c_off"
        tailscale version | head -1
      fi
      return 0
      ;;
    xray)
      # Tests the new binary against the live config and rolls back if the
      # service does not come up.
      /usr/local/lib/gateway/xray-update.sh "${1:-latest}"
      ;;
    adguard|adguardhome)
      /usr/local/lib/gateway/adguard-update.sh "${1:-latest}"
      ;;
    tailscale)
      # apt-managed, so it follows the distro package rather than a release.
      apt_proxy_on
      apt-get update -qq && apt-get -y install --only-upgrade tailscale
      apt_proxy_off
      ;;
    geo|geodata)
      /usr/local/lib/gateway/geoupdate.sh "${1:-}"
      ;;
    packages|apt)
      apt_proxy_on
      apt-get update -qq && apt-get -y upgrade
      apt_proxy_off
      ;;
    services)
      # What the scheduled updater runs by default: the three things nothing
      # else keeps current, each of which tests itself and rolls back. apt is
      # left to unattended-upgrades, which does security only — an unattended
      # full `apt upgrade` on the box the whole house routes through is a
      # bigger bet than a binary that reverts when it fails to start.
      info "updating geodata"
      /usr/local/lib/gateway/geoupdate.sh || warn "geodata update failed"
      info "updating Xray"
      /usr/local/lib/gateway/xray-update.sh latest || warn "Xray update failed"
      if [ -x /opt/AdGuardHome/AdGuardHome ]; then
        info "updating AdGuard Home"
        /usr/local/lib/gateway/adguard-update.sh latest || warn "AdGuard update failed"
      fi
      ;;
    all)
      # Ordered least- to most-disruptive, and each step is survivable on its
      # own: geodata rolls back, both binaries roll back, apt is apt.
      info "updating geodata"
      /usr/local/lib/gateway/geoupdate.sh || warn "geodata update failed"
      info "updating Xray"
      /usr/local/lib/gateway/xray-update.sh latest || warn "Xray update failed"
      if [ -x /opt/AdGuardHome/AdGuardHome ]; then
        info "updating AdGuard Home"
        /usr/local/lib/gateway/adguard-update.sh latest || warn "AdGuard update failed"
      fi
      info "updating packages"
      apt_proxy_on
      apt-get update -qq && apt-get -y upgrade
      apt_proxy_off
      info "re-applying config"
      cmd_apply
      ;;
    *)
      die "unknown update target: $what
  try: all | services | xray [version] | adguard [version] | tailscale | geo | packages | --check"
      ;;
  esac
}

# Only relevant before the tunnel exists. apt has no SOCKS support of its own
# beyond this setting, and leaving it configured permanently would break apt
# the day the bootstrap proxy goes away — so it is written and removed around
# the commands that need it.
APT_PROXY_CONF=/etc/apt/apt.conf.d/99-gw-bootstrap-proxy
apt_proxy_on() {
  local proxy="${GW_PROXY:-}"
  [ -z "$proxy" ] && proxy=$(gw_env BOOTSTRAP_PROXY)
  [ -z "$proxy" ] && return 0
  info "using the bootstrap proxy for apt: $proxy"
  cat > "$APT_PROXY_CONF" <<CONF
// Written by \`gw\` for this command only; removed when it finishes.
Acquire::http::Proxy "$proxy";
Acquire::https::Proxy "$proxy";
CONF
}
apt_proxy_off() { rm -f "$APT_PROXY_CONF"; }

# ----------------------------------------------------------------- panic ----
cmd_panic() {
  need_root panic
  warn "disabling interception — ALL traffic will go out unproxied via the router"
  nft delete table inet gateway 2>/dev/null || true
  /usr/local/lib/gateway/ip-rules.sh down || true
  systemctl stop gw-health.timer 2>/dev/null || true
  sysctl -qw net.ipv4.ip_forward=1
  nft -f - <<'NFT'
table ip gwpanic
delete table ip gwpanic
table ip gwpanic {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        masquerade
    }
}
NFT
  # Routing alone is not "working internet". resolv.conf still points at
  # AdGuard, whose upstreams ride the tunnel that just failed — so DNS stays
  # dead and panic mode would look like it did nothing.
  local router
  router=$(gw_env ROUTER)
  if getent hosts example.com >/dev/null 2>&1; then
    info "DNS still resolving — leaving /etc/resolv.conf alone"
  elif [ -n "$router" ]; then
    [ -f /etc/resolv.conf ] && cp -a /etc/resolv.conf /etc/resolv.conf.gw-bak
    printf '# Written by `gw panic`. `gw apply` puts this back once AdGuard answers.\nnameserver %s\n' \
      "$router" > /etc/resolv.conf
    warn "DNS was dead; /etc/resolv.conf now points at the router ($router)"
    warn "previous file kept at /etc/resolv.conf.gw-bak"
  else
    warn "DNS is not resolving and no router is known — set /etc/resolv.conf by hand"
  fi

  warn "panic mode active. Clients keep working, unproxied. Run 'gw apply' to restore."
}

# ------------------------------------------------------------------ logs ----
cmd_logs() { journalctl -fu xray -u gw-network -u gw-health -u AdGuardHome -t gw-health "$@"; }

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$REPO/bin/gw"; }

# --proxy applies to every download this run makes; it overrides
# bootstrap.socks_proxy from the config.
if [ "${1:-}" = "--proxy" ]; then
  export GW_PROXY="${2:?--proxy needs a URL, e.g. socks5h://127.0.0.1:1080}"
  shift 2
fi

case "${1:-}" in
  render) shift; cmd_render "$@" ;;
  diff)   shift; cmd_diff "$@" || true ;;
  apply)  shift; cmd_apply "$@" ;;
  enable)  shift; cmd_enable "$@" ;;
  disable) shift; cmd_disable "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  status) shift; cmd_status "$@" ;;
  check)  shift; cmd_check "$@" ;;
  diag)   shift; cmd_diag "$@" ;;
  trace)  shift; cmd_trace "$@" ;;
  history) shift; cmd_history "$@" ;;
  bench)  shift; cmd_bench "$@" ;;
  client) shift; cmd_client "$@" ;;
  job)    shift; cmd_job "$@" ;;
  web-passwd) shift; cmd_web_passwd "$@" ;;
  init)   shift; cmd_init "$@" ;;
  update) shift; cmd_update "$@" ;;
  panic)  shift; cmd_panic "$@" ;;
  logs)   shift; cmd_logs "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try: gw help)" ;;
esac
